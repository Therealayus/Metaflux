{
  "name": "socialflux",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.7.1",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @socialflux/web dev",
    "dev:api": "pnpm --filter @socialflux/api dev",
    "dev:worker": "pnpm --filter @socialflux/worker dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @socialflux/database generate",
    "db:migrate": "pnpm --filter @socialflux/database migrate",
    "db:push": "pnpm --filter @socialflux/database push",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
