# --- Core ---
NODE_ENV=development
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# --- Database / Redis / Storage ---
DATABASE_URL=postgresql://metaflux:metaflux_dev@localhost:5432/metaflux
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=metaflux
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Auth ---
AUTH_SECRET=change-me-to-a-32-char-minimum-secret
SESSION_COOKIE_NAME=metaflux_session
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Encryption (32-byte base64 keys; generate with `pnpm --filter @metaflux/security gen:key`) ---
TOKEN_ENCRYPTION_KEY=
API_KEY_PEPPER=

# --- Meta ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v21.0
META_OAUTH_REDIRECT_URL=http://localhost:4000/api/v1/connections/meta/callback
META_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token

# --- AI (provider-neutral; configure at least one) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Billing ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
LOG_LEVEL=info
